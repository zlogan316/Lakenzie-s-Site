lakenzie.example.com {
    # API → FastAPI container (service name "api" on the compose network)
    reverse_proxy /api/* api:8000

    # Everything else: the built SPA. try_files falls back to /index.html so
    # client-side routes like /games/wordle work on direct load / refresh.
    root * /srv
    encode gzip
    try_files {path} /index.html
    file_server
}
